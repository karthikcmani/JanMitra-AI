# JanMitra AI — Backend Environment Template
# Fill in your production values in backend/.env or Render Environment Variables

PROJECT_NAME="JanMitra AI"
API_V1_STR="/api/v1"

# Local PostgreSQL Fallback (for local offline dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=janmitra_ai

# Production Supabase PostgreSQL Connection String
# Format 1 (Direct): postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?ssl=require
# Format 2 (Session Pooler IPv4): postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/janmitra_ai
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/janmitra_ai

# Security / Auth
SECRET_KEY=your_production_secret_jwt_key_here_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8000","*"]

# AI Service Keys
GEMINI_API_KEY=your_gemini_api_key_here
